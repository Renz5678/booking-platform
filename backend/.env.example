# ============================================================
# Alaga Counseling Platform — Environment Variables Reference
# ============================================================
# Copy this file to .env and fill in ALL values before running.
# NEVER commit the real .env file to version control.
#
# Generate secure random values with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

# --- Database ---
# PostgreSQL connection string (asyncpg driver required)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/alaga_db

# --- Authentication ---
# REQUIRED: Must be a cryptographically random string, minimum 32 hex chars.
# ⚠️  DO NOT use "supersecret", "secret", "changeme" or any dictionary word.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX

# --- Data Encryption (Google OAuth Tokens) ---
# REQUIRED: Must be exactly 32 bytes (64 hex chars) of random data.
# Used to encrypt counselor Google refresh tokens at rest.
# ⚠️  DO NOT use sequential numbers (e.g. 12345678...).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX

# --- GCash Manual Payment (ACTIVE payment method) ---
# Displayed to clients on the booking confirmation page and in the payment email.
# The counselor checks GCash manually and clicks "Mark as Paid" in their dashboard.
GCASH_NUMBER=09XXXXXXXXXX
GCASH_NAME=Your Full Name Here

# --- PayMongo (DISABLED — automated gateway, reserved for future use) ---
# Leave these blank while using the manual GCash flow.
# When ready to switch: fill in keys, restore create_paymongo_checkout() in
# services/payment_service.py, and register the webhook in the PayMongo dashboard.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# --- Google OAuth (for Google Calendar / Gmail integration) ---
# Obtain from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
# Optional: System-level refresh token for sending Gmail notifications.
# Leave blank to disable email features until a token is set.
GOOGLE_REFRESH_TOKEN=

# --- CAPTCHA ---
# REQUIRED for production: obtain from https://www.google.com/recaptcha/admin
# ⚠️  Leaving these blank disables bot protection on all public forms.
RECAPTCHA_SECRET_KEY=REPLACE_WITH_RECAPTCHA_SECRET_KEY
RECAPTCHA_SITE_KEY=REPLACE_WITH_RECAPTCHA_SITE_KEY

# --- Application ---
# Set to "production" in the live deployment environment.
# Controls dev-only endpoints (simulate-success) and security header enforcement.
ENVIRONMENT=development

# The public URL of the Next.js frontend — used for CORS and frontend email links.
# ⚠️  Must match the exact deployed URL (no trailing slash).
FRONTEND_URL=http://localhost:3000

# The public URL of the FastAPI backend — used for generating API links in emails
# (e.g., the ICS calendar download link). Defaults to http://localhost:8000.
BACKEND_URL=http://localhost:8000

# Admin email — used for admin alert notifications from the system
ADMIN_EMAIL=admin@example.com

# --- Redis (for Celery task queue and rate-limit state) ---
REDIS_URL=redis://localhost:6379/0

# --- Sentry (optional but recommended for production error tracking) ---
# Obtain from https://sentry.io → Settings → Projects → DSN
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Cloudinary (optional — for counselor profile photo uploads) ---
# Obtain from https://console.cloudinary.com → Dashboard → API Keys
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=
